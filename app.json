{
	"expo": {
		"name": "calitrack-ts",
		"slug": "calitrack-ts",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/logo-fond.webp",
		"scheme": "calitrackts",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/logo-fond.webp",
				"backgroundColor": "#FFF9F7"
			},
			"edgeToEdgeEnabled": true
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/logo-fond.webp"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/logo-fond.webp",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#FFF9F7",
					"dark": {
						"backgroundColor": "#132541"
					}
				}
			],
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"project": "calitrack",
					"organization": "roulette-oy"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
